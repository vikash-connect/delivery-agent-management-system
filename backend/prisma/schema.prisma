datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AgentStatus {
  ACTIVE
  INACTIVE
}

model DeliveryAgent {
  id          String      @id @default(uuid())
  fullName    String
  phoneNumber String      @unique
  email       String      @unique
  serviceArea String
  status      AgentStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([serviceArea])
  @@index([fullName])
  @@map("delivery_agents")
}
